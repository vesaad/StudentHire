NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# MySQL lokal: vendos përdoruesin, fjalëkalimin (URL-encoded) dhe portën reale.
DATABASE_URL="mysql://studenthire:replace-with-your-local-password@127.0.0.1:3306/studenthire"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Tokeni skadon pas 15 minutash.
UPLOAD_DIR=uploads/cvs
# Kufiri i CV-së është 5 MB, i përcaktuar në cv-storage.js.
ADMIN_EMAIL=admin@studenthire.local
# Administratori krijohet nga procesi i kontrolluar në fazën 5.
